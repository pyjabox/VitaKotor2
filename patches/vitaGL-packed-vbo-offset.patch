@@ -373,0 +375,14 @@ typedef struct {
+static inline uint32_t get_packed_vbo_base(program *p) {
+	uint32_t base = 0;
+	GLboolean found = GL_FALSE;
+	for (int i = 0; i < p->attr_num; i++) {
+		uint8_t attr_idx = p->attr_map[i];
+		if ((cur_vao->vertex_attrib_state & (1 << attr_idx)) &&
+				(!found || cur_vao->vertex_attrib_offsets[attr_idx] < base)) {
+			base = cur_vao->vertex_attrib_offsets[attr_idx];
+			found = GL_TRUE;
+		}
+	}
+	return base;
+}
